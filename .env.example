# Razorpay server credentials (use Test Mode keys until checkout is verified)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Programme sale price in Indian rupees (original price: INR 10,000)
FAST_BOWLING_PROGRAM_PRICE_INR=7499

# Resend account used to email the purchased PDFs. The sender must use a
# domain verified in Resend before emails can be sent to customers.
RESEND_API_KEY=
PROGRAM_EMAIL_FROM="Be An Athlete <programs@your-verified-domain.com>"

# Contact form enquiries are delivered here.
CONTACT_EMAIL_TO=hiteshjangid1201@gmail.com

# Admin panel. DATABASE_URL is injected when a Neon Postgres database is
# connected to this Vercel project. BLOB_READ_WRITE_TOKEN is injected when a
# public Vercel Blob store is connected.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Used only to create the first administrator record in an empty database.
# After the first login, the password can be changed from the admin panel.
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=

# Generate a random value with at least 32 characters and never commit it.
ADMIN_AUTH_SECRET=
